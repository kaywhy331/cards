# Optional: switch production persistence from Netlify Blobs to Supabase.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Recommended: 32 random bytes encoded as base64url for integration-secret encryption.
# When omitted, the app creates and persists a random key in its server-only store.
EZCARDS_MASTER_KEY=

# Recommended: independent random secret for signed background-worker envelopes.
EZCARDS_INTERNAL_SECRET=

# Local tests only. Never set in production.
EZCARDS_MEMORY_STORE=0
